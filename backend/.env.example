NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bikestore

# Use a random value of 32+ characters. Keep the real .env out of Git.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=2h
# Production: list exact frontend origins separated by commas.
# Development also permits localhost/127.0.0.1 Vite ports such as 5173 and 5174.
CORS_ORIGIN=http://localhost:5173

# Local development accounts. Change these passwords before sharing/deploying.
SEED_ADMIN_NAME=Administrador BikeStore
SEED_ADMIN_EMAIL=admin@bikestore.local
SEED_ADMIN_PASSWORD=BikeStoreAdmin2026!
# Password required to create or promote an administrator in the admin panel.
ADMIN_CREATION_PASSWORD=admin123
SEED_CLIENT_NAME=Cliente BikeStore
SEED_CLIENT_EMAIL=cliente@bikestore.local
SEED_CLIENT_PASSWORD=BikeStoreCliente2026!

# Password recovery uses Gmail SMTP. Enable Google's 2-Step Verification,
# create an App Password, then put the values in your private backend/.env.
# Never use your normal Gmail password or commit backend/.env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender label/address; defaults to GMAIL_USER.
MAIL_FROM=
